// Copy this file to `secrets.h` and fill in your own values.
// `secrets.h` is gitignored so your WiFi password and bot token never get
// committed. `secrets.h.example` is the version that IS committed.
#pragma once

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-wifi-password"
#define BOT_TOKEN     "123456789:your-telegram-bot-token"
#define CHAT_ID       "your-telegram-chat-id"

// Hostname for mDNS. The dashboard will be at http://<HOSTNAME>.local/
#define HOSTNAME      "sourdough"
